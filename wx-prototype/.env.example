# Greece Sky Weather — configuration
#
# Copy this file to `.env` and fill in the values. The app loads it at startup;
# real environment variables always win over this file, so a systemd unit or a
# container `-e` flag is never silently overridden.
#
# `.env` is gitignored. It holds API keys — never commit it.

# ---------------------------------------------------------------- χάρτης
#
# Δεν χρησιμοποιούνται πλακίδια χάρτη και δεν φορτώνεται βιβλιοθήκη χάρτη: η
# θέση επιλέγεται με αναζήτηση, geolocation ή χειροκίνητες συντεταγμένες. Οι
# παλιές μεταβλητές WX_TILE_* αφαιρέθηκαν — δεν διαβάζονταν από τον κώδικα.
# Ιστορικό και εναλλακτικοί πάροχοι (αν ποτέ προστεθεί χάρτης): LICENSES.md.

# ---------------------------------------------------------------- κάμερες
#
# Short form: id -> snapshot URL. Name, region and coordinates come from the two
# built-in sites (ilioupoli, glinado). A key that matches no built-in still
# becomes a camera, with only an id and a URL.
#
# WX_CAMERAS={"ilioupoli":"https://YOUR_SNAPSHOT_URL_1","glinado":"https://YOUR_SNAPSHOT_URL_2"}
#
# Long form, when you need a timelapse or a custom name/location:
#
# WX_CAMERAS=[{"id":"ilioupoli","name":"Ilioupoli Sky","lat":37.9333,"lon":23.75,"snapshot":"https://YOUR_SNAPSHOT_URL_1","timelapse":"https://YOUR_TIMELAPSE_URL_1"},{"id":"glinado","name":"Glinado Sky","lat":37.0667,"lon":25.4167,"snapshot":"https://YOUR_SNAPSHOT_URL_2"}]
#
# Snapshot cadence per camera (minutes: 1/2/5/10/15/30/60; default 5). The
# snapshot is the low-resource mode — no video crosses this server.
#   "snapshot_interval_min": 5
#
# Live mode is a *provider*, not a stream we host. Today the supported provider
# is YouTube: set live_enabled and a PUBLIC video/live id. The id is public and
# is embedded through the official player; the camera's own address is never sent
# to the browser.
#   "live_enabled": true, "live_provider": "youtube", "youtube_live_id": "PUBLIC_ID"
#
# "enabled": false hides a camera entirely (list and detail both).

# ------------------------------------------------------- κάμερες: private source
#
# NEVER in WX_CAMERAS and never sent to the browser. This separate variable holds
# the address/credentials a future server-side stream pipeline will use. Leave it
# unset until a real camera is wired up. The host must match
# WX_CAMERA_ALLOWED_HOSTS when that allowlist is set. Do not embed credentials in
# the URL — use username/secret_ref. `secret_ref` names the env var holding the
# password; the value itself lives there, not here. Audio is rejected: video-only.
#
# WX_CAMERA_SOURCES=[{"id":"ilioupoli","url":"rtsp://CAMERA_LAN_HOST:554/Streaming/Channels/101","username":"viewer","secret_ref":"WX_CAMERA_ILIOUPOLI_PASS"}]
# WX_CAMERA_ALLOWED_HOSTS=CAMERA_LAN_HOST

# ---------------------------------------------------------------- δημόσια στοιχεία
# Contact details shown in the site footer and on the legal pages. The defaults
# point at the public accounts; override them here if a handle changes, so a
# correction does not need a code change and a redeploy.
#
# WX_YOUTUBE_URL=https://www.youtube.com/@YOUR_HANDLE
# WX_FACEBOOK_URL=https://www.facebook.com/YOUR_PAGE
# WX_EMAIL=support@yourdomain.gr

# ---------------------------------------------------------------- πληρωμές (Stripe)
# Leave these unset to run without payments: the passcode and the trial still
# work, /api/plans reports checkout_available=false, and the payment button is
# disabled instead of pretending to work. Set all four to take money.
#
# Auto-renewal is Stripe's default for a subscription, so nothing here enables
# it — the user's opt-out happens later, on the Subscription, via /api/subscription.
#
# WX_STRIPE_SECRET_KEY=sk_test_xxx      # sk_live_xxx in production
# WX_STRIPE_PRICE_MONTHLY=price_xxx
# WX_STRIPE_PRICE_YEARLY=price_xxx
# WX_STRIPE_WEBHOOK_SECRET=whsec_xxx    # from the webhook endpoint in Stripe
# WX_PUBLIC_BASE_URL=https://yourdomain.gr   # for the redirect after payment

# ---------------------------------------------------------------- runtime
# Where downloaded GRIB/NetCDF files are cached. Give it real disk: a full GFS
# cycle is large, and a tmpfs-backed /tmp can fill up.
# WX_CACHE_DIR=/tmp/wx-cache

# Μέγιστο μέγεθος σώματος αιτήματος (MB). 1 MB υπερκαλύπτει κάθε νόμιμο POST
# (κωδικός promo, Stripe session id, ένα analytics batch, μία μέτρηση Ecowitt)
# και επιστρέφει 413 πάνω από αυτό. 0 το απενεργοποιεί.
# WX_MAX_BODY_MB=1

# Πόσο δευτερόλεπτα θυμάται το "ποιος κύκλος GFS δημοσιεύτηκε" (memoization του
# network probe που στέκεται πίσω από το /api/health). Προεπ. 300.
# WX_RUN_LOOKUP_TTL_S=300

# Shared model-run grid (grids.py + scheduler.py). Off by default: με το flag
# ανοιχτό, το Greece box κατεβάζεται μία φορά ανά κύκλο αντί ανά σημείο, και
# κάθε αίτημα εξυπηρετείται από τη RAM. Το per-point cache παραμένει fallback.
# Άναψέ το όταν θες τα downloads να μην κλιμακώνονται με τους χρήστες.
# WX_USE_RAM_GRIDS=1
#
# Πόσα runs ανά μοντέλο κρατά στο δίσκο (κάτω από WX_CACHE_DIR/grids/). Προεπ. 2.
# WX_GRID_KEEP_RUNS=2
#
# Πόσο box κρατά το ICON-EU grid. "greek" (προεπ., ~1.8 MB) ή "europe" (~65 MB).
# WX_RAM_ICON_SCOPE=greek
#
# Κάθε πόσο γίνεται refresh pass (δευτ.) και κάθε πόσο retry μετά από αποτυχία.
# WX_RAM_REFRESH_S=21600
# WX_RAM_RETRY_S=1200

# ---------------------------------------------------------------- απαιτείται στο production
# Με WX_ENV=production η εκκίνηση αποτυγχάνει αν λείπει οποιοδήποτε από τα δύο:
# δεν υπάρχει usable default για κανένα. Σε dev/staging αρκεί προειδοποίηση.
#
# Παράγαγε τα με:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#
# WX_SECRET — κλειδί υπογραφής των entitlement tokens.
# WX_MASTER_CODE — passcode που δίνει PRO (comps/tests). Δεν είναι Stripe:
#   δίνει PRO entitlement χωρίς χρέωση, ελεγχόμενο πάντα στον server.
# WX_ENV=production
# WX_SECRET=
# WX_MASTER_CODE=

# ---------------------------------------------------------------- κωδικοί PRO (promo/gift)
# Κωδικοί που δίνουν PRO χωρίς πληρωμή, ελεγχόμενοι πάντα στον server — όπως
# ακριβώς και η πληρωμένη συνδρομή. Δημιουργούνται μέσω του /api/admin/promo,
# όχι από αυτό το αρχείο.
#
# Απαιτείται μυστικό για το admin endpoint. Αν δεν οριστεί, το /api/admin/promo
# απαντά 404 ώστε να μην υπάρχει ανοιχτή διαχείριση κωδικών:
# WX_ADMIN_TOKEN=άλλαξέ-το-σε-τυχαίο-μυστικό

# ---------------------------------------------------------------- analytics (self-hosted)
# Καταγραφή χρήσης πρώτου μέρους: χωρίς τρίτους, χωρίς IP, χωρίς ακριβείς
# συντεταγμένες (κρατιέται κύτταρο ~50 km). Αποθηκεύεται στην ίδια SQLite (WX_DB).
# Άφησέ το unset για ενεργό· WX_ANALYTICS=0 το απενεργοποιεί εντελώς (no-op).
# WX_ANALYTICS=1
#
# Πόσες ημέρες κρατούνται οι ακατέργαστες εγγραφές πριν διαγραφούν. Ο
# καθαρισμός τρέχει αυτόματα (μία φορά την ώρα, με αφορμή το ίδιο το ingest),
# ώστε να μη χρειάζεται cron. WX_ANALYTICS_RETENTION_DAYS=0 τον απενεργοποιεί
# και αφήνει τον πίνακα να μεγαλώνει χωρίς όριο — δεν συνιστάται.
# WX_ANALYTICS_RETENTION_DAYS=365

# ---------------------------------------------------------------- ειδοποιήσεις push (PRO)
# Απαιτούνται και τα δύο κλειδιά για να ενεργοποιηθεί το Web Push. Χωρίς αυτά,
# τα /api/push/* απαντούν 503 και η υπόλοιπη εφαρμογή λειτουργεί κανονικά.
#
# Δημιούργησέ τα μία φορά ανά εγκατάσταση:
#   pip install "pywebpush>=2.0" "cryptography>=42"
#   python -c "import notify; notify.print_vapid_keys()"
# Αντέγραψε τις δύο γραμμές που τυπώνει εδώ. Και τα δύο κλειδιά είναι base64url,
# όπως τα περιμένει το py_vapid. Το ιδιωτικό δεν βγαίνει ποτέ σε log.
# WX_VAPID_PUBLIC_KEY=
# WX_VAPID_PRIVATE_KEY=
#
# Το email/URL επικοινωνίας που στέλνεται στον πάροχο push ως VAPID `sub`.
# Προαιρετικό: χωρίς αυτό χρησιμοποιείται το WX_CONTACT_EMAIL.
# WX_VAPID_SUBJECT=mailto:you@example.com
#
# Κάθε πόσα δευτερόλεπτα σαρώνει ο scheduler τα forecasts για ειδοποιήσεις.
# WX_NOTIFY_INTERVAL_S=900
#
# Κάθε πόσο ξαναρωτά τη Stripe για την κατάσταση των συνδρομητών (δευτερόλεπτα).
# WX_NOTIFY_PRO_REFRESH_S=21600
#
# Πόσες ημέρες κρατείται το ιστορικό των ειδοποιήσεων που στάλθηκαν (dedupe).
# WX_NOTIFY_RETENTION_DAYS=30
